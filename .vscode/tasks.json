{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: cl.exe build Money Saver",
            "command": "cl.exe",
            "args": [
                "/Zi",
                "/EHsc",
                "/nologo",
                "/std:c++17",
                "/Fo${workspaceFolder}\\prototypes\\",
                "/Fd${workspaceFolder}\\prototypes\\MoneySavingWidgetCompiler.pdb",
                "/Fe${workspaceFolder}\\prototypes\\MoneySavingWidget.exe",
                "${workspaceFolder}\\data\\MoneySavingWidgetPrototype.cpp",
                "${workspaceFolder}\\data\\MoneySaverWindow.cpp",
                "${workspaceFolder}\\data\\DepositButton.cpp",
                "${workspaceFolder}\\data\\SavingsProgress.cpp",
                "${workspaceFolder}\\bin\\SavingsData.cpp",
                "/link",
                "User32.lib",
                "Gdi32.lib"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ],
    "version": "2.0.0"
