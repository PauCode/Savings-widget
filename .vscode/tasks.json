{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: cl.exe build Money Saver",
            "command": "cl.exe",
            "args": [
                "/Zi",
                "/EHsc",
                "/nologo",
                "/std:c++17",
                "/Fe${workspaceFolder}\\MoneySavingWidget.exe",
                "${workspaceFolder}\\MoneySavingWidgetPrototype.cpp",
                "${workspaceFolder}\\MoneySaverWindow.cpp",
                "${workspaceFolder}\\DepositButton.cpp",
                "${workspaceFolder}\\SavingsProgress.cpp",
                "${workspaceFolder}\\SavingsData.cpp",
                "/link",
                "User32.lib",
                "Gdi32.lib"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ],
    "version": "2.0.0"
}